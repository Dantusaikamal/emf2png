{
  "name": "emf-to-png",
  "version": "0.2.0",
  "description": "WASM-based EMF to PNG/JPEG converter for Node.js. No Office, LibreOffice, or Inkscape required.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./bin/emf-to-png.mjs"
  },
  "bin": {
    "emf-to-png": "./bin/emf-to-png.mjs"
  },
  "files": [
    "dist/**/*",
    "bin/emf-to-png.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "emf",
    "vector",
    "converter",
    "png",
    "jpeg",
    "svg",
    "wasm",
    "nodejs",
    "graphics",
    "docx"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:wasm:emf": "node scripts/build-wasm.emf.mjs",
    "build:wasm": "npm run build:wasm:emf",
    "build:js": "tsup src/index.ts --format esm --dts --clean",
    "build": "npm run build:wasm && npm run build:js && node scripts/postbuild-copy-wasm.mjs",
    "test": "vitest run",
    "test:pack": "node scripts/smoke-packed.mjs",
    "prepack": "npm run build:js && node scripts/postbuild-copy-wasm.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run test:pack"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.1",
    "tsup": "^8.0.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
